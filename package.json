{
  "name": "lib-address",
  "description": "A library to format and validate addresses based on Google's open-source address metadata.",
  "homepage": "https://github.com/LancelotP/lib-address",
  "repository": {
    "type": "git",
    "url": "https://github.com/LancelotP/lib-address.git"
  },
  "bugs": {
    "url": "https://github.com/LancelotP/lib-address/issues"
  },
  "author": {
    "email": "lancelot@prigent.dev",
    "name": "Lancelot Prigent"
  },
  "sideEffects": false,
  "version": "0.6.3",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@9.6.0",
  "keywords": [
    "address",
    "metadata",
    "country",
    "formatter",
    "validator",
    "iso",
    "iso 3166-1",
    "iso 3166-2"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && check-export-map",
    "preview": "vite preview",
    "test": "vitest",
    "lint": "biome check",
    "lint:ci": "biome ci",
    "lint:fix": "biome check --write",
    "coverage": "vitest run --coverage",
    "scripts:download": "pnpm dlx tsx --tsconfig scripts/tsconfig.json scripts/generate-metadata.ts"
  },
  "main": "./dist/entry-browser.mjs",
  "module": "./dist/entry-browser.mjs",
  "require": "./dist/entry-browser.mjs",
  "types": "./dist/entry-browser.d.ts",
  "exports": {
    ".": {
      "types": "./dist/entry-browser.d.ts",
      "browser": "./dist/entry-browser.mjs",
      "import": "./dist/entry-node.mjs",
      "require": "./dist/entry-node.cjs"
    },
    "./lite": {
      "types": "./dist/entry-lite.d.ts",
      "browser": "./dist/entry-lite.mjs",
      "import": "./dist/entry-lite.mjs",
      "require": "./dist/entry-lite.cjs"
    },
    "./zod": {
      "types": "./dist/validators/zod.d.ts",
      "import": "./dist/validators/zod.mjs",
      "require": "./dist/validators/zod.cjs"
    },
    "./countries/*": "./countries/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "countries"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.2.5",
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^20.8.10",
    "@vitest/coverage-v8": "^3.2.4",
    "axios": "^1.12.2",
    "axios-retry": "^3.8.1",
    "check-export-map": "^1.3.1",
    "cli-progress": "^3.12.0",
    "immutability-helper": "^3.1.1",
    "rollup-plugin-visualizer": "^6.0.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4"
  },
  "optionalDependencies": {
    "zod": "^3.25.76"
  }
}
